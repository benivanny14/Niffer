# Niffer Cosmetics — mazingira (env)
# Nakili faili hii kuwa `.env.local` na jaza thamani halisi.
# `.env*` hairuhusiwi kuingizwa kwenye git.

# ── Admin ──────────────────────────────────────────────
# Nywila ya dashibodi ya admin (/admin). BADILISHA kabla ya production.
ADMIN_PASSWORD=niffer2026

# ── Database ───────────────────────────────────────────
# Ukurasa wa faili la SQLite. Chagua `.data/niffer.db` (default).
# NIFFER_DB_FILE=.data/niffer.db

# ── Malipo (AzamPay) ───────────────────────────────────
# Ikiwa hujajaza hizi, oda huendelea kwa "lipa baada ya kupokea" (COD).
# AZAMPAY_APP_ID=
# AZAMPAY_MERCHANT_ID=
# AZAMPAY_API_KEY=
# AZAMPAY_BASE_URL=https://apigw.azampay.co
# Token ya callback ya gateway (header `x-callback-token`).
# Production: WEKA HII — bila hii callback inakataliwa (fail-closed).
# PAYMENT_CALLBACK_TOKEN=
# Mode ya majaribio (mzunguko kamili bila malipo halisi): AZAMPAY_MOCK=1
# AZAMPAY_MOCK=1

# ── URL ya tovuti ──────────────────────────────────────
# Inatumika kwenye malipo (returnUrl/failureUrl). Default: http://localhost:3000
# APP_URL=https://niffer.example.co.tz
# NEXT_PUBLIC_SITE_URL=https://niffer.example.co.tz

# ── Arifa za admin (barua pepe — nyepesi, hiari) ───────
# Ikiwa RESEND_API_KEY na ADMIN_EMAIL zimewekwa, oda mpya na hakiki
# hutumwa kwa barua pepe. Bila hizi, arifa hubaki kwenye dashibodi pekee.
# RESEND_API_KEY=re_xxxxxxxx
# ADMIN_EMAIL=info@niffer.co.tz
# EMAIL_FROM=Niffer <onboarding@resend.dev>
